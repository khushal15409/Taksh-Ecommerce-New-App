# Razorpay Configuration
# Get your keys from: https://dashboard.razorpay.com/app/keys

# Razorpay Test/Live Key ID
RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Razorpay Test/Live Key Secret (Keep this secure!)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Google Places (address search suggestions in the map picker)
# Enable "Places API" for this key. Use a key that is not restricted to Android/iOS
# apps only (this is an HTTP call), or restrict it to the Places API.
# Without it the address search falls back to plain geocoding.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
